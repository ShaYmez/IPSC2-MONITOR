[Unit]
Description=IPSC2-style dashboard sidecar for RYSEN / System X
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ipsc2-monitor
ExecStart=/opt/ipsc2-monitor/.venv/bin/python /opt/ipsc2-monitor/ipsc2mon.py
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
